{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
      }
    },
    {
      "name": "Debug-Gimbal",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INFANTRY_BOARD_GIMBAL": "1"
      }
    },
    {
      "name": "Release-Gimbal",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INFANTRY_BOARD_GIMBAL": "1"
      }
    },
    {
      "name": "Debug-Chassis",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INFANTRY_BOARD_GIMBAL": "0"
      }
    },
    {
      "name": "Release-Chassis",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INFANTRY_BOARD_GIMBAL": "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug-Gimbal",
      "configurePreset": "Debug-Gimbal"
    },
    {
      "name": "Release-Gimbal",
      "configurePreset": "Release-Gimbal"
    },
    {
      "name": "Debug-Chassis",
      "configurePreset": "Debug-Chassis"
    },
    {
      "name": "Release-Chassis",
      "configurePreset": "Release-Chassis"
    }
  ]
}
