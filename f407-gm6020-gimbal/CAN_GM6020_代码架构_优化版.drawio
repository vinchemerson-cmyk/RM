  <diagram id="control-flow" name="02-闭环控制数据流">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2_title" value="GM6020 双模式闭环控制数据流" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_hint" value="绿色：目标与控制输出　蓝色：编码器/速度反馈　红色虚线：超时保护" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="920" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p2_controller" value="motor_control.c / 1 ms 控制周期" style="swimlane;startSize=36;horizontal=1;container=1;pointerEvents=0;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="1820" height="710" as="geometry" />
        </mxCell>

        <mxCell id="p2_sine" value="正弦目标发生器&#xa;按模式输出角度或速度&#xa;幅值 / 周期可配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="40" y="80" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_mode" value="当前模式？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="p2_controller">
          <mxGeometry x="340" y="80" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_angle_target" value="单圈角度目标&#xa;归一化到 0°～360°" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="610" y="55" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_arc" value="优劣弧 + 多圈解析&#xa;劣弧：最短路径&#xa;优弧：反向长路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="900" y="55" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_angle_pid" value="角度 PID 外环&#xa;多圈角度误差&#xa;输出目标速度 ±100 rpm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="p2_controller">
          <mxGeometry x="1210" y="55" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_speed_target" value="速度模式目标&#xa;正弦速度直接进入内环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="900" y="210" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p2_speed_pid" value="速度 PID 内环&#xa;目标速度 - 实际速度&#xa;输出转矩电流指令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="p2_controller">
          <mxGeometry x="1510" y="135" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_can_tx" value="电流限幅 + CAN 打包&#xa;±8192，ID 1 → DATA[0:1]&#xa;标准帧 0x1FE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="p2_controller">
          <mxGeometry x="1510" y="300" width="250" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p2_feedback" value="反馈状态结构体&#xa;总角度 / 速度 / 电流&#xa;温度 / last_rx_tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="610" y="400" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_feedback_bus" value="反馈分配&#xa;角度 / 速度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="p2_controller">
          <mxGeometry x="1210" y="260" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_unwrap" value="编码器多圈检测&#xa;8191 ↔ 0 跨零处理&#xa;累计 turn_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="930" y="400" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_can_rx" value="CAN 反馈接收&#xa;StdId 0x205 / DLC 8&#xa;机械角、速度、电流、温度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="1210" y="400" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_motor" value="GM6020（ID=1）&#xa;内置电调执行电流指令&#xa;约 1 kHz 发送反馈" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="p2_controller">
          <mxGeometry x="1570" y="460" width="190" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p2_timeout" value="100 ms 反馈超时保护&#xa;PID 复位&#xa;强制发送零电流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="1510" y="600" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p2_telemetry" value="6 路 CSV 遥测&#xa;目标/反馈角度、速度&#xa;电流与温度，50 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="610" y="585" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_uart" value="HAL_UART_Transmit()&#xa;USART6 / 115200-8-N-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="930" y="585" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_host" value="串口调试/绘图软件&#xa;按逗号解析一行 6 个数" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="p2_controller">
          <mxGeometry x="1250" y="585" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p2_note" value="模式切换建议：切换时清空角度环/速度环积分项，并用当前反馈初始化目标，避免电流突变。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="240" y="870" width="1440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_files" value="对应文件：Core/Src/main.c　Core/Src/motor_control.c　Core/Inc/motor_control.h　Core/Src/can.c　Core/Src/usart.c" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="280" y="960" width="1360" height="40" as="geometry" />
        </mxCell>

        <!-- 上方控制主链 -->
        <mxCell id="p2_e_sine_mode" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2e7d32;strokeWidth=3;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_sine" target="p2_mode">
